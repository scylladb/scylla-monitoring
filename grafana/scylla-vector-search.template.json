                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.99, sum(rate(fts_highlight_latency_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    }
                                ],
                                "layout": "AutoGridLayout"
                            }
                        ]
                    }

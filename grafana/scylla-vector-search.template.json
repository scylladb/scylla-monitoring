{
    "dashboard": {
        "class": "dashboard",
        "rows": [
            {
                "class": "row",
                "height": "150px",
                "panels": [
                    {
                        "gridPos": {
                            "w": 4,
                            "h": 5
                        },
                        "class": "small_stat",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "noValue": " Offline",
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "red",
                                            "value": null
                                        },
                                        {
                                            "color": "green",
                                            "value": 1
                                        }
                                    ]
                                },
                                "mappings": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "0": {
                                                "text": "Offline"
                                            }
                                        }
                                    },
                                    {
                                        "type": "range",
                                        "options": {
                                            "from": 1,
                                            "to": null,
                                            "result": {
                                                "text": "Online",
                                                "index": 1,
                                                "color": "green"
                                            }
                                        }
                                    }
                                ]
                            }
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "count(scrape_samples_scraped{job=\"vector_search\"}) OR vector(0)",
                        "title": "Status"
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "mappings": [],
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        }
                                    ]
                                },
                                "unit": "",
                                "color": {
                                    "mode": "fixed",
                                    "fixedColor": "blue"
                                }
                            },
                            "overrides": []
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "max(count(index_size{job=\"vector_search\", instance=~\"$node\"}) by (instance))",
                        "title": "# Indexes"
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "custom": {
                                    "hideFrom": {
                                        "tooltip": false,
                                        "viz": false,
                                        "legend": false
                                    }
                                },
                                "color": {
                                    "mode": "palette-classic"
                                },
                                "mappings": [],
                                "unit": "decbytes"
                            },
                            "overrides": []
                        },
                        "data/spec/queries": [
                            {
                                "class": "graph_query",
                                "spec/query/spec/expr": "avg(sum(node_filesystem_size_bytes{job=\"vector_search_os\", instance=~\"$node\"} - node_filesystem_avail_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by (instance, cluster))",
                                "spec/query/spec/legendFormat": "Used",
                                "spec/query/spec/instant": true,
                                "spec/query/spec/range": false
                            },
                            {
                                "class": "graph_query",
                                "spec/refId": "B",
                                "spec/query/spec/expr": "avg(sum(node_filesystem_avail_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by (instance))",
                                "spec/query/spec/legendFormat": "Free"
                            }
                        ],
                        "title": "Disk Usage"
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "mappings": [],
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        }
                                    ]
                                },
                                "unit": "decbytes",
                                "color": {
                                    "mode": "fixed",
                                    "fixedColor": "blue"
                                }
                            },
                            "overrides": []
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "avg(sum(node_filesystem_size_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by (instance, cluster) -sum(node_filesystem_avail_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by (instance, cluster)) by ([[by]])",
                        "data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}}",
                        "title": "Disk Usage"
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat_area",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "custom": {},
                                "unit": "percent",
                                "decimals": 0,
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "red",
                                            "value": 90
                                        }
                                    ]
                                },
                                "mappings": []
                            },
                            "overrides": []
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "100*avg(sum(rate(node_cpu_seconds_total{job=\"vector_search_os\", mode!~\"idle\", instance=~\"$node\"}[1m])) by(cpu)) by ([[by]])",
                        "title": "CPU",
                        "description": ""
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat_area",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "mappings": [],
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "red",
                                            "value": 0.8
                                        }
                                    ]
                                },
                                "unit": "percentunit",
                                "min": 0,
                                "max": 1,
                                "decimals": 0
                            },
                            "overrides": []
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "1-avg(node_memory_MemAvailable_bytes{job=\"vector_search_os\", instance=~\"$node\"})/avg(node_memory_MemTotal_bytes{job=\"vector_search_os\", instance=~\"$node\"})",
                        "data/spec/queries/0/spec/query/spec/legendFormat": "Used",
                        "title": "Memory % Usage"
                    },
                    {
                        "gridPos": {
                            "w": 3,
                            "h": 5
                        },
                        "class": "small_stat",
                        "vizConfig/spec/fieldConfig": {
                            "defaults": {
                                "mappings": [],
                                "thresholds": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        }
                                    ]
                                },
                                "unit": "decbytes",
                                "color": {
                                    "mode": "fixed",
                                    "fixedColor": "blue"
                                },
                                "min": 0
                            },
                            "overrides": []
                        },
                        "data/spec/queries/0/spec/query/spec/expr": "avg(node_memory_MemTotal_bytes{job=\"vector_search_os\", instance=~\"$node\"} - node_memory_MemAvailable_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by ([[by]])",
                        "data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}}",
                        "title": "Memory Usage"
                    }
                ],
                "title": "Summary row"
            },
            {
                "class": "row",
                "panels": [
                    {
                        "gridPos": {
                            "h": 8,
                            "w": 6
                        },
                        "class": "bytes_panel",
                        "spec/title": "Disk Usage by [[by]]",
                        "spec/description": "Average Disk Usage",
                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(sum(node_filesystem_size_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by (cluster, dc, instance, rack)-sum(node_filesystem_avail_bytes{job=\"vector_search_os\", instance=~\"$node\"})by (cluster, dc, instance, rack)) by ([[by]])"
                    },
                    {
                        "gridPos": {
                            "h": 8,
                            "w": 6
                        },
                        "class": "bytes_panel",
                        "spec/title": "Memory Usage by [[by]]",
                        "spec/description": "Average Disk Usage",
                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(node_memory_MemTotal_bytes{job=\"vector_search_os\", instance=~\"$node\"}-node_memory_MemAvailable_bytes{job=\"vector_search_os\", instance=~\"$node\"}) by ([[by]])"
                    },
                    {
                        "gridPos": {
                            "h": 8,
                            "w": 6
                        },
                        "class": "percentunit_panel",
                        "spec/title": "CPU Usage by [[by]]",
                        "spec/description": "Average CPU Usage",
                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(sum(rate(node_cpu_seconds_total{mode != \"idle\", instance=~\"$node\"}[1m])) by (cluster, cpu, instance)) by ([[by]])"
                    }
                ],
                "title": "OS Information"
            },
            {
                "class": "row",
                "title": "Indexes",
                "variables": [
                    {
                        "kind": "QueryVariable",
                        "spec": {
                            "current": {
                                "text": "All",
                                "value": "$__all"
                            },
                            "hide": "dontHide",
                            "refresh": "onTimeRangeChanged",
                            "skipUrlSync": false,
                            "query": {
                                "kind": "DataQuery",
                                "group": "prometheus",
                                "version": "v0",
                                "datasource": {
                                    "name": "prometheus"
                                },
                                "spec": {
                                    "__legacyStringValue": "label_values(index_size{},index_name)"
                                }
                            },
                            "regex": "",
                            "regexApplyTo": "value",
                            "sort": "numericalAsc",
                            "definition": "",
                            "options": [],
                            "multi": true,
                            "includeAll": true,
                            "allValue": ".*",
                            "allowCustomValue": true,
                            "name": "index",
                            "label": "index"
                        }
                    }
                ],
                "tabs": [
                    {
                        "class": "row",
                        "title": "$index",
                        "repeat": "index",
                        "variables": [
                            {
                                "kind": "QueryVariable",
                                "spec": {
                                    "current": {
                                        "text": "",
                                        "value": ""
                                    },
                                    "hide": "hideVariable",
                                    "refresh": "onTimeRangeChanged",
                                    "skipUrlSync": true,
                                    "query": {
                                        "kind": "DataQuery",
                                        "group": "prometheus",
                                        "version": "v0",
                                        "datasource": {
                                            "name": "prometheus"
                                        },
                                        "spec": {
                                            "__legacyStringValue": "label_values(fts_index_size_bytes{index_name=\"$index\"},index_name)"
                                        }
                                    },
                                    "regex": "",
                                    "regexApplyTo": "value",
                                    "sort": "disabled",
                                    "definition": "",
                                    "options": [],
                                    "multi": false,
                                    "includeAll": false,
                                    "allowCustomValue": false,
                                    "name": "fts_index",
                                    "label": "fts_index"
                                }
                            }
                        ],
                        "rows": [
                            {
                                "class": "row",
                                "title": "Overview",
                                "panels": [
                                    {
                                        "span": 2,
                                        "class": "graph_panel",
                                        "spec/title": "Indexed items",
                                        "spec/description": "Number of items in the index: vectors for a vector index, documents for a full-text index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(index_size{index_name=\"$index\", instance=~\"$node\"}) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}"
                                    },
                                    {
                                        "span": 2,
                                        "class": "ops_panel",
                                        "spec/title": "Indexing rate",
                                        "spec/description": "Rate of items inserted, updated and removed from the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(rate(index_modified{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name, operation)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}} {{operation}}"
                                    },
                                    {
                                        "span": 2,
                                        "class": "ops_panel",
                                        "spec/title": "Index requests rate",
                                        "spec/description": "Rate of requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(rate(request_latency_seconds_count{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}"
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "Average Latency",
                                        "spec/description": "Average latency of requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(rate(request_latency_seconds_sum{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])/rate(request_latency_seconds_count{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}"
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "P95 Latency",
                                        "spec/description": "95th percentile latency of requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}"
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "P99 Latency",
                                        "spec/description": "99th percentile latency of requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.99, sum(rate(request_latency_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}"
                                    }
                                ]
                            },
                            {
                                "class": "row",
                                "title": "Indexing",
                                "panels": [
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "Indexing lag P50",
                                        "spec/description": "50th percentile time from a write in ScyllaDB until it is searchable. Recorded for CDC writes only, not for the initial full scan",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.50, sum(rate(indexing_lag_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "Indexing lag P99",
                                        "spec/description": "99th percentile time from a write in ScyllaDB until it is searchable. Recorded for CDC writes only, not for the initial full scan",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.99, sum(rate(indexing_lag_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "graph_panel",
                                        "spec/title": "CDC readers up",
                                        "spec/description": "1 if the CDC reader is running, 0 if it is stopped",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "min(cdc_reader_up{index_name=\"$index\", instance=~\"$node\"}) by ([[by]], index_name, reader)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}} {{reader}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "CDC checkpoint age",
                                        "spec/description": "Time since the point in the CDC log up to which the reader has consumed all changes",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "max(time() - cdc_last_processed_timestamp_seconds{index_name=\"$index\", instance=~\"$node\"}) by ([[by]], index_name, reader)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}} {{reader}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "ops_panel",
                                        "spec/title": "CDC handler errors",
                                        "spec/description": "Rate of errors while handling CDC changes",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "sum(rate(cdc_handler_errors_total{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name, reader)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}} {{reader}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "ops_panel",
                                        "spec/title": "CDC reader restarts",
                                        "spec/description": "Rate of CDC reader restarts after an error",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "sum(rate(cdc_reader_restarts_total{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name, reader)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}} {{reader}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    }
                                ],
                                "layout": "AutoGridLayout"
                            },
                            {
                                "class": "row",
                                "title": "Full-text search",
                                "conditionalRendering": {
                                    "class": "conditionalRendering_var",
                                    "spec/items/0/spec/variable": "fts_index"
                                },
                                "panels": [
                                    {
                                        "span": 2,
                                        "class": "bytes_panel",
                                        "spec/title": "Full-text index size",
                                        "spec/description": "Size of the full-text index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(fts_index_size_bytes{index_name=\"$index\", instance=~\"$node\"}) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },

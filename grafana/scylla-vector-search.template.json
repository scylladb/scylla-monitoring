            {
                "title": "",
                "collapse": false,
                "rows": [
                    {
                        "class": "monitoring_version_row"
                    }
                ]
            }
        ],
        "tags": [
            "__SCYLLA_VERSION_DOT__"
        ],
        "time": {
            "from": "now-30m",
            "to": "now"
        },
        "overwrite": true,
        "version": 1,
        "spec/title": "Vector Search",
        "metadata/name": "vector-search-__SCYLLA_VERSION_DASHED__",
        "spec/variables": [
            {
                "kind": "CustomVariable",
                "spec": {
                    "name": "by",
                    "query": "Cluster : cluster, Node : instance",
                    "current": {
                        "tags": [],
                        "text": "Cluster",
                        "value": "cluster"
                    },
                    "options": [
                        {
                            "selected": true,
                            "text": "Cluster",
                            "value": "cluster"
                        },
                        {
                            "selected": false,
                            "text": "Node",
                            "value": "instance"
                        }
                    ],
                    "multi": false,
                    "includeAll": false,
                    "label": "by",
                    "hide": "dontHide",
                    "skipUrlSync": false,
                    "allowCustomValue": true,
                    "valuesFormat": "csv"
                }
            },
            {
                "kind": "QueryVariable",
                "spec": {
                    "current": {
                        "text": "All",
                        "value": "$__all"
                    },
                    "hide": "dontHide",
                    "refresh": "onTimeRangeChanged",
                    "skipUrlSync": false,
                    "query": {
                        "kind": "DataQuery",
                        "group": "prometheus",
                        "version": "v0",

                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(fts_segment_count{index_name=\"$index\", instance=~\"$node\"}) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "ops_panel",
                                        "spec/title": "Highlight request rate",
                                        "spec/description": "Rate of highlight requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(rate(fts_highlight_latency_seconds_count{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "Highlight request average latency",
                                        "spec/description": "Average latency of highlight requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "avg(rate(fts_highlight_latency_seconds_sum{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])/rate(fts_highlight_latency_seconds_count{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], index_name)",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,
                                        "class": "seconds_panel",
                                        "spec/title": "Highlight request P95 latency",
                                        "spec/description": "95th percentile latency of highlight requests to the index",
                                        "spec/data/spec/queries/0/spec/query/spec/expr": "histogram_quantile(0.95, sum(rate(fts_highlight_latency_seconds_bucket{index_name=\"$index\", instance=~\"$node\"}[$__rate_interval])) by ([[by]], keyspace,index_name, le))",
                                        "spec/data/spec/queries/0/spec/query/spec/legendFormat": "{{instance}} {{index_name}}",
                                        "conditionalRendering": {
                                            "class": "conditionalRendering_data"
                                        }
                                    },
                                    {
                                        "span": 2,

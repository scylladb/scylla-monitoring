[Unit]
Description=Start the monitoring config watcher when its config file is written

# One PathChanged= per --config-file of scylla-monitoring-config.service. A
# write starts a stopped watcher; a stop without a new file keeps it stopped.
[Path]
PathChanged=/home/centos/scylla-monitoring/scylla-monitoring.yaml
Unit=scylla-monitoring-config.service

[Install]
WantedBy=multi-user.target
